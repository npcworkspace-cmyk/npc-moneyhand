{
  "manifest_version": 3,
  "name": "npc-moneyhand",
  "description": "A thin, WS-only Chrome execution hand for local AI agents.",
  "version": "1.2.0",
  "version_name": "1.2.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "alarms",
    "debugger",
    "downloads",
    "storage",
    "tabs",
    "windows"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/smile-red-16.png",
    "32": "icons/smile-red-32.png",
    "48": "icons/smile-red-48.png",
    "128": "icons/smile-red-128.png"
  },
  "action": {
    "default_title": "npc-moneyhand",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/smile-red-16.png",
      "32": "icons/smile-red-32.png",
      "48": "icons/smile-red-48.png",
      "128": "icons/smile-red-128.png"
    }
  }
}
